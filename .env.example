# Copiá este archivo como .env y completá los valores

# Obtenelo desde MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@cluster.mongodb.net/feria-la-camelia

# Cualquier cadena larga y aleatoria (se genera automáticamente en Render)
SESSION_SECRET=cambia-esto-por-una-cadena-secreta-larga

# No cambiar en producción (Render lo setea solo)
NODE_ENV=development
